{
    "type": "project",
    "name": "olecarl/api",
    "description": "RESTful Web-API using Symfony with API-Platform",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_sqlite": "*",
        "api-platform/doctrine-orm": "^4.2.19",
        "api-platform/symfony": "^4.2.19",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.2",
        "nelmio/cors-bundle": "^2.6.1",
        "phpdocumentor/reflection-docblock": "^6.0.2",
        "phpstan/phpdoc-parser": "^2.3.2",
        "symfony/asset": "^8.0.6",
        "symfony/asset-mapper": "^7.4.6",
        "symfony/console": "^8.0.6",
        "symfony/dotenv": "^8.0.6",
        "symfony/expression-language": "^8.0.4",
        "symfony/flex": "^2.10",
        "symfony/framework-bundle": "^8.0.6",
        "symfony/monolog-bundle": "^4.0.1",
        "symfony/property-access": "^8.0.4",
        "symfony/property-info": "^8.0.6",
        "symfony/requirements-checker": "^2.0.3",
        "symfony/runtime": "^8.0.1",
        "symfony/security-bundle": "^8.0.6",
        "symfony/serializer": "^8.0.6",
        "symfony/twig-bundle": "^8.0.4",
        "symfony/validator": "^8.0.6",
        "symfony/yaml": "^8.0.6"
    },
    "config": {
        "allow-plugins": {
            "codeception/c3": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "test": [
            "vendor/bin/codecept run --steps --html --version",
            "vendor/bin/phpstan --version analyse",
            "vendor/bin/phpmetrics --git --version --report-html=./build/phpmetrics/ ."
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "requirements-checker": "script",
            "composer validate": "script",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "php-cs-fixer fix": "script",
            "vendor/bin/codecept build": "script"
        },

        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.3"
        }
    },
    "require-dev": {
        "codeception/c3": "^2.9",
        "codeception/codeception": "^5.3.5",
        "codeception/module-asserts": "^3.3.0",
        "codeception/module-doctrine": "^3.3",
        "codeception/module-phpbrowser": "^3.0.2",
        "codeception/module-rest": "^3.4.3",
        "codeception/module-symfony": "^3.8",
        "friendsofphp/php-cs-fixer": "^3.94.2",
        "phpmetrics/phpmetrics": "^2.9.1",
        "phpstan/phpstan": "^2.1.40",
        "phpunit/phpunit": "^12.5.14",
        "symfony/browser-kit": "7.3.*",
        "symfony/css-selector": "7.3.*",
        "symfony/maker-bundle": "^1.66.0",
        "symfony/panther": "^2.4"
    }
}
